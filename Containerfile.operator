# kura-operator (RFC 0009), from the weebo-containerfile template like the
# server's Containerfile: same pinned bases, cargo-chef, distroless runtime.
# Keep its FROM lines in step with Containerfile (updatecli moves all three).
# ── Build stage ───────────────────────────────────────────────────────────────
FROM docker.io/library/rust:1.100-slim-trixie@sha256:6f14b2b4b278ec0d50aa1d69541c304ce0f95e0f6268487aa9924af1c2e9aebe AS chef

RUN cargo install --locked cargo-chef@0.1.78

WORKDIR /build

# ── Planner: workspace manifests → recipe.json ────────────────────────────────
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY patches/ patches/
RUN cargo chef prepare --recipe-path recipe.json

# ── Builder: dependencies (cached while recipe.json is unchanged), then sources ─
# Only kura-operator: kura-operator-testkit (envtest, Go) is never built here.
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
COPY patches/ patches/
RUN cargo chef cook --locked --release -p kura-operator --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build --locked --release -p kura-operator

# ── Runtime image ─────────────────────────────────────────────────────────────
# Writes nothing to disk but the kit's /tmp (an emptyDir in the chart).
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:532c7a94f9e96ba9db75eb9388f4227751131c7cb0a411d1a8521af4096135de AS runtime

COPY --from=builder /build/target/release/kura-operator /usr/local/bin/kura-operator

# Numeric non-root UID, the one the chart's securityContext pins.
USER 65532:65532

LABEL org.opencontainers.image.title="kura-operator" \
      org.opencontainers.image.description="Hands KuraTenant and KuraVault custom resources to kura-server" \
      org.opencontainers.image.source="https://github.com/batleforc/weebo-kura" \
      org.opencontainers.image.licenses="Apache-2.0"

ENTRYPOINT ["/usr/local/bin/kura-operator"]
