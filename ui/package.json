{
  "name": "kura-ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "openapi-ts && vue-tsc --noEmit && vite build",
    "types:check": "vue-tsc --noEmit",
    "lint": "openapi-ts && vue-tsc --noEmit && biome check",
    "format": "biome check --write",
    "test": "openapi-ts && vitest run --coverage",
    "generate:client": "openapi-ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.18",
    "fflate": "0.8.3",
    "markdown-it": "^15.0.3",
    "mermaid": "12.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@hey-api/openapi-ts": "~0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.21.0"
}
